# 虚拟环境（换机时整目录拷贝，不入库）
.venv/

# API key 配置文件（C3：付费引擎密钥，永远不进库）
api_keys.local.json

# Python 字节码
__pycache__/
*.pyc
*.pyo

# PyInstaller 中间产物与分发包
build/
dist/
分发/
*.spec

# 运行时产物（交接稿第 1 节铁律 5：不删，但也不入库）
cache/
logs/
转换日志.txt
自检结果.txt

# 样例成品（体积大且可再生，源文件入库即可）
*_双语.*
*自检报告.txt
*译后编辑清单.json
术语库状态.txt

# 离线模型（750MB，随整目录拷贝分发，不入库）
models/

# 临时测试脚本
_t_*.py
.pytest_cache/

# 质量对比报告（--bench 运行时产物，与自检结果.txt 同类，不入库）
质量对比报告_*.txt

# 自托管服务配置（v1.6.3：里面是单位内部服务器地址，不入库）
自定义引擎.json

# 分段规则表（v1.8.0：单位自己的切句口径，与 自定义引擎.json 同类，不入库）
分段规则.json

# 助手工作区（会话 scratch，与项目代码无关，不入库）
.workbuddy/
